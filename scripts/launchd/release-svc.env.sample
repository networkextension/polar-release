# This file is `source`d by the launchd wrapper (set -a; source …). Any value
# containing shell metacharacters MUST be single-quoted — especially a DSN with
# more than one query param, whose '&' would otherwise background the assignment
# and leave the var EMPTY (svc then falls back to its built-in default DSN).
#   BAD :  POLAR_RELEASE_DB_DSN=postgres:///polar_release?host=/tmp&sslmode=disable
#   GOOD:  POLAR_RELEASE_DB_DSN='postgres:///polar_release?host=/tmp&sslmode=disable'
POLAR_DOCK_BASE=http://127.0.0.1:8080
POLAR_PLUGIN_NAME=release
POLAR_PLUGIN_TOKEN=polar_plugin_REPLACE_ME
POLAR_RELEASE_DB_DSN=postgres://ideamesh@127.0.0.1:5432/polar_release?sslmode=disable
POLAR_RELEASE_LISTEN=127.0.0.1:8101
POLAR_RELEASE_VERSION=0.0.1
# 32-byte ed25519 seed (openssl rand -hex 32). Clients pin the PUBLIC half;
# leave unset only on a throwaway dev box (rotates every restart).
POLAR_RELEASE_SIGNING_KEY=REPLACE_ME_openssl_rand_hex_32
